  {
    "ku_id": "GZ-SY-00053",
    "title": "设备间无供暖致冬季管道冻裂，引发墙体渗水",
    "stage": "STAGE_04",
    "role": [
      "ROLE_OWNER",
      "ROLE_CONTRACTOR"
    ],
    "severity": "SEV_CRITICAL",
    "problem_type": [
      "TYPE_QUALITY",
