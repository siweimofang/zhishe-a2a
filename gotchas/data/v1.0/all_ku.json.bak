[
  {
    "ku_id": "GZ-SY-00001",
    "title": "承重墙拆除会致整栋楼结构性破坏",
    "stage": "STAGE_02",
    "role": [
      "ROLE_OWNER",
      "ROLE_DESIGNER",
      "ROLE_CONTRACTOR"
    ],
    "severity": "SEV_CRITICAL",
    "problem_type": [
      "TYPE_QUALITY"
    ],
    "trade": [
      "TRADE_DEMOLISH",
      "TRADE_DESIGN"
    ],
    "material": [],
    "description": "业主或设计师为扩大空间、改变布局，要求拆除承重墙或阳台垛子。承重墙承担上部楼层荷载，拆除后会导致楼板下沉、墙体开裂，严重时可致整栋楼结构性破坏。部分施工方为接单谎称'可以拆'或'加固就行'，实际违法且极其危险。户型图上承重墙用斜线填充表示，普通墙为空心线。",
    "typical_scenario": "沈阳某业主89平两居，想把客厅和阳台打通扩大面积，施工方说'加根梁就行'。拆完三个月后楼上邻居墙体出现裂缝，物业鉴定为承重墙被拆导致，要求恢复并赔偿，总损失超8万元。",
    "how_to_avoid": "1. 设计方案确定前：到物业或住建部门调取原始结构图，确认所有承重墙位置。2. 任何涉及拆墙的方案：必须由有资质的结构工程师出具书面评估。3. 施工前：在拆改方案图上用红色标注承重墙，工人进场时逐墙确认。4. 发现施工方建议拆承重墙：立即更换施工方，这是安全底线不可妥协。",
    "evidence": {
      "source_type": "industry_standard",
      "source_ref": "GB 50011建筑抗震设计规范、GB 50210建筑装饰装修工程质量验收标准",
      "frequency": "中频(10-30%)",
      "confidence": "高(多源验证)"
    },
    "causal_chain": {
      "root_cause": "业主追求空间效果，施工方为接单不负责任",
      "direct_cause": "拆除承重墙或阳台垛子",
      "consequence": "楼板下沉、墙体开裂、整栋楼结构受损，面临强制恢复+赔偿+行政处罚"
    },
    "related_ku_ids": [
      "GZ-SY-00002",
      "GZ-SY-00012"
    ],
