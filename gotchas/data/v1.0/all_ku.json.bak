  {
    "ku_id": "GZ-SY-00013",
    "title": "电线分色不规范导致后期维修触电风险和接线错误",
    "stage": "STAGE_04",
    "role": [
      "ROLE_CONTRACTOR",
      "ROLE_OWNER"
