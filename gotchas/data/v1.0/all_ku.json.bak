  {
    "title": "照明设计未分区导致能耗浪费",
    "stage": "STAGE_02",
    "role": [
      "ROLE_OWNER",
      "ROLE_DESIGNER"
    ],
    "severity": "SEV_LOW",
    "problem_type": [
