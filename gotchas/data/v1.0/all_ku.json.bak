      "GZ-SY-00054"
    ],
    "causal_chain": {
      "root_cause": "一楼/地下空间排水点位低于主排水管道",
      "direct_cause": "重力排水高差不足，排水缓慢或倒灌",
      "consequence": "污水倒灌损坏装修材料，产生异味，影响居住"
    },
