    "title": "小瓷砖和马赛克因热胀冷缩脱落，少用卫生间尤其高发",
    "stage": "STAGE_05",
    "role": [
      "ROLE_OWNER",
      "ROLE_DESIGNER"
    ],
    "severity": "SEV_MEDIUM",
    "problem_type": [
