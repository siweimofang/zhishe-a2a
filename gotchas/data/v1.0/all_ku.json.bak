  {
    "ku_id": "GZ-SY-00006",
    "title": "全屋定制投影报价不含五金灯具，实际总价高出30-50%",
    "stage": "STAGE_03",
    "role": [
      "ROLE_OWNER",
      "ROLE_INDUSTRY"
    ],
    "severity": "SEV_HIGH",
