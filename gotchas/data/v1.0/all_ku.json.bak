  {
    "ku_id": "GZ-SY-00026",
    "title": "阳光房排水设计未考虑邻户边界，单向排水导致雨水溢入邻居家",
    "stage": "STAGE_02",
    "role": [
      "ROLE_OWNER",
      "ROLE_DESIGNER"
    ],
    "severity": "SEV_HIGH",
