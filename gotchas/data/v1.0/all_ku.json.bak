      "frequency": "高频(30-60%)",
      "confidence": "中(单源可靠)"
    },
    "causal_chain": {
      "root_cause": "设计阶段未遵循节能原则，照明分区不细致",
      "direct_cause": "单一开关控制所有灯具，无法按需开启",
      "consequence": "能耗浪费、使用不便，后期改造困难且成本高"
    },
