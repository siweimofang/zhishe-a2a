  {
    "ku_id": "GZ-SY-00030",
    "title": "厨房台面高度650-700mm时不适合用岩板上墙，截面无法隐藏性价比低",
    "stage": "STAGE_02",
    "role": [
      "ROLE_OWNER",
      "ROLE_DESIGNER"
    ],
    "severity": "SEV_MEDIUM",
    "problem_type": [
