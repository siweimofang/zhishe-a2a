    "title": "开门位置可能存在过梁和承重点，不先用电镐试探就砸墙有结构风险",
    "stage": "STAGE_04",
    "role": [
      "ROLE_CONTRACTOR",
      "ROLE_DESIGNER"
    ],
    "severity": "SEV_CRITICAL",
    "problem_type": [
