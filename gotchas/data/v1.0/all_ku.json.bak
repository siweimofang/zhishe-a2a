  {
    "title": "嵌入式筒灯开孔尺寸不符导致返工",
    "stage": "STAGE_05",
    "role": [
      "ROLE_OWNER",
      "ROLE_DESIGNER",
      "ROLE_CONTRACTOR"
    ],
    "severity": "SEV_MEDIUM",
    "problem_type": [
      "TYPE_QUALITY",
      "TYPE_OMISSION"
    ],
    "trade": [
      "TRADE_ELECTRICAL",
      "TRADE_CARPENTRY"
    ],
    "material": [
      "MAT_APPLIANCE"
    ],
    "scope": "universal",
    "description": "嵌入式筒灯/射灯需在天花开孔，孔径必须与灯具尺寸匹配。若开孔过大，灯具无法固定，易脱落；开孔过小则装不进去。常见问题是施工方未核对灯具开孔尺寸，凭经验开孔，导致返工。损失包括吊顶修复费用、灯具更换费用，以及工期延误。",
    "typical_scenario": "业主购买了一款开孔直径75mm的筒灯，木工在吊顶时按常规80mm开孔，结果灯具安装后松动，有脱落风险。业主要求返工，木工用石膏修补重新开孔，但吊顶留下修补痕迹，影响美观，额外花费约1500元。",
    "how_to_avoid": "1. 购买灯具后，将开孔尺寸（直径、深度）明确告知设计师和施工方。2. 施工前提供灯具样品或开孔模板给木工。3. 开孔时现场监督，使用游标卡尺测量。4. 开孔后试装，确认灯具卡紧无松动。",
    "evidence": {
      "source_type": "expert_opinion",
      "source_ref": "设计师实战经验",
      "frequency": "高频(30-60%)",
      "confidence": "中(单源可靠)"
    },
    "causal_chain": {
      "root_cause": "施工方未核对灯具开孔规格",
      "direct_cause": "开孔尺寸与灯具不匹配",
      "consequence": "灯具松动、吊顶修复、返工损失"
    },
    "ku_id": "GZ-SY-00080",
