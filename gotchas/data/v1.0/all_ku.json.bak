  {
    "ku_id": "GZ-SY-00039",
    "title": "弧形墙板做一体弧工艺费用翻倍，分段制作可节省30-50%成本",
    "stage": "STAGE_03",
    "role": [
      "ROLE_OWNER",
      "ROLE_DESIGNER"
    ],
    "severity": "SEV_MEDIUM",
    "problem_type": [
      "TYPE_COST",
      "TYPE_DESIGN"
    ],
    "trade": [
