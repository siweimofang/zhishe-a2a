  {
    "ku_id": "GZ-SY-00002",
    "title": "报价漏项：水电改造不包在总价内，签约后增项1.5-2.5万",
    "stage": "STAGE_03",
    "role": [
      "ROLE_OWNER",
      "ROLE_INDUSTRY"
    ],
    "severity": "SEV_HIGH",
    "problem_type": [
      "TYPE_OMISSION",
      "TYPE_COST"
    ],
    "trade": [
      "TRADE_PLUMBING",
      "TRADE_ELECTRICAL"
    ],
    "material": [
      "MAT_PIPE",
      "MAT_WIRE"
    ],
    "description": "装修公司报价时故意漏掉水电改造费用，以'水电实测实量'为由在签约后单独计费。沈阳市场80-100平住宅，水电改造实际费用通常在1.5-2.5万元，占装修总价的15-25%。这是最常见的增项手段，60%以上的装修纠纷涉及此问题。报价单上8.8万'拎包入住'，实际加水电后超10万。",
    "typical_scenario": "沈阳某业主89平两居室，预算10万全包。装修公司报价8.8万，签约后告知水电改造需另计，实际增加2.1万元。业主投诉至消协，但因合同未明确水电包含范围，维权困难。",
    "how_to_avoid": "1. 签约前：要求报价单包含水电改造预估费用，明确'水电包死'或'水电不超过总价X%'的条款。2. 合同中：约定水电改造的计价方式（按米/按点位），并设定增项上限（如不超过预算10%）。3. 施工中：水电完工后现场测量实际用量，与预估对比，超出部分需书面确认。",
    "evidence": {
      "source_type": "consumer_complaint",
      "source_ref": "中消协2025年家装投诉报告；knowledge.json k013/k021",
      "frequency": "极高频(>60%)",
      "confidence": "高(多源验证)"
    },
    "causal_chain": {
      "root_cause": "装修公司追求低报价吸引签约",
      "direct_cause": "报价单故意漏掉水电改造费用",
      "consequence": "签约后增项1.5-2.5万元，总价超出预算20-30%"
    },
    "related_ku_ids": [
      "GZ-SY-00003",
      "GZ-SY-00004",
      "GZ-SY-00005"
    ],
