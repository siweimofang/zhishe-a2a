  {
    "ku_id": "GZ-SY-00003",
    "title": "水电按米实报实销：施工方绕路虚报米数致费用翻倍",
    "stage": "STAGE_03",
    "role": [
      "ROLE_OWNER",
      "ROLE_CONTRACTOR"
    ],
    "severity": "SEV_HIGH",
    "problem_type": [
      "TYPE_FRAUD",
      "TYPE_COST"
    ],
    "trade": [
      "TRADE_PLUMBING",
      "TRADE_ELECTRICAL"
    ],
    "material": [
      "MAT_PIPE",
      "MAT_WIRE"
    ],
    "description": "水电改造按米数'实报实销'是装修最大陷阱之一。施工方有动机拉高米数：故意绕路（原本12米的线路绕弯走20米）、重复走线（同一段管路包两遍）、测量时虚报米数。沈阳行情：水管35-50元/米、电线20-35元/米、弱电15-25元/米。90平正常水电全改预估8000-15000元，但按米实报常达18000-25000元。",
    "typical_scenario": "沈阳某业主90平两居，合同写'水电按实际米数结算'。完工后施工方报水管120米（正常约60米）、电线200米（正常约120米），水电总费用2.3万，比预估多出1万。业主质疑但无施工前照片取证。",
    "how_to_avoid": "1. 合同写'水电总价包干'或'单价×预估米数×上下浮动≤10%'。2. 施工中业主在场确认实测米数，逐段核对米数表。3. 写明'非故意绕路'违约责任。4. 验收时打压测试+拍照存档管路走向，作为争议时的证据。",
    "evidence": {
      "source_type": "expert_opinion",
      "source_ref": "knowledge.json k021；赫慕空间设计实测数据",
      "frequency": "高频(30-60%)",
      "confidence": "高(多源验证)"
    },
    "causal_chain": {
      "root_cause": "按米计价模式让施工方有动机拉长米数",
      "direct_cause": "故意绕路、重复走线、虚报米数",
      "consequence": "水电费用超出预估80-100%，业主无证据难以维权"
    },
    "related_ku_ids": [
      "GZ-SY-00002",
      "GZ-SY-00011"
    ],
    "metadata": {
