  {
    "ku_id": "GZ-SY-00055",
    "title": "新风除湿一体机在北方一楼管道积水风险高，技术验证不足",
    "stage": "STAGE_02",
    "role": [
      "ROLE_OWNER",
      "ROLE_DESIGNER"
    ],
    "severity": "SEV_MEDIUM",
    "problem_type": [
      "TYPE_QUALITY",
      "TYPE_COMMUNICATION"
