      "confidence": "中(单源可靠)"
    },
    "causal_chain": {
      "root_cause": "忽视屏幕反射特性，灯光布局未考虑观看视角",
      "direct_cause": "灯具功率过大或位置正对屏幕，产生反射眩光",
      "consequence": "电视/电脑无法正常使用，需更换灯具或调整布局，产生额外费用"
