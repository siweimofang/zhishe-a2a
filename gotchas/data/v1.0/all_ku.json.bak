      "confidence": "中(单源可靠)"
    },
    "causal_chain": {
      "root_cause": "施工方为省线或图方便混用电线颜色",
      "direct_cause": "火线零线地线分色不符合国标",
      "consequence": "后期维修触电风险、插座接线错误、漏电保护器误动作"
    },
