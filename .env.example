# === 主力模型:DeepSeek-V4-Pro ===
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === 千问 A2A 鉴权 ===
# 千问调你时会在请求头带 X-API-Key,跟你这里配的对得上才放行
# 留空 = 不校验(本地联调方便,生产务必配置)
A2A_API_KEY=your-a2a-shared-secret-here

# === 服务 ===
A2A_SERVER_HOST=0.0.0.0
A2A_SERVER_PORT=8765

# === 部署到公网后改成永久地址,AgentCard 用这个拼 URL ===
# 当前永久地址:https://tunnel.zhishe.top(等域名审核通过 + 命名隧道上线)
PUBLIC_BASE_URL=https://tunnel.zhishe.top

# === 流式响应(Qwen 当前不需要,保持关闭) ===
STREAMING_ENABLED=false

# === 日志 ===
LOG_LEVEL=INFO
