# 知设装修顾问 · 环境变量模板(铁律 75 第 3 项:默认私有,不带真实 key)
# 复制此文件为 .env,然后填入真实值
# 真实 .env 必走密钥管理(90 天轮换 + 600 权限 + 不进 Git)

# === API 鉴权 ===
ZHISHE_API_KEY=replace-with-real-key-32-chars-min

# === DeepSeek API(铁律 72 立:Authorization Header 必填) ===
DEEPSEEK_API_KEY=replace-with-real-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# === A2A 协议 ===
A2A_PROTOCOL_VERSION=0.2.5
PUBLIC_BASE_URL=https://tunnel.zhishe.top

# === 安全配置(铁律 75 v2:默认私有) ===
ZHISHE_PUBLIC_NETWORK=false
ZHISHE_REQUIRE_ENV_API_KEY=true
ZHISHE_LOG_MASK_PII=true
LOG_LEVEL=INFO

# === 服务端口 ===
PORT=8765

# === 数据隐私(铁律 75 第 4 项:日志脱敏) ===
LOG_MASK_NAMES=true
LOG_MASK_PHONES=true
LOG_MASK_ADDRESSES=true